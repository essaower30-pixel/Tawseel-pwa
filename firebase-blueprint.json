{
  "entities": {
    "orders": {
      "title": "Orders",
      "description": "Customer orders synchronized across Admin, Store Owner, Driver and Customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "storeId", "status", "total"]
    },
    "stores": {
      "title": "Stores",
      "description": "Registered stores and service providers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "ownerPhone": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "category"]
    },
    "drivers": {
      "title": "Drivers",
      "description": "Delivery drivers and taxi captains",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "vehicleType": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "rating": { "type": "number" }
      },
      "required": ["id", "name", "phone"]
    },
    "registrations": {
      "title": "Registrations",
      "description": "Pending requests to join as store or captain",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "name", "phone", "status"]
    },
    "reviews": {
      "title": "Reviews",
      "description": "Customer ratings and feedback for stores and captains",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "orderId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" }
      },
      "required": ["id", "storeId", "rating"]
    }
  },
  "firestoreRules": {
    "/databases/{database}/documents": {
      "orders/{orderId}": {
        "allow": {
          "read": "true",
          "write": "true"
        }
      },
      "stores/{storeId}": {
        "allow": {
          "read": "true",
          "write": "true"
        }
      },
      "drivers/{driverId}": {
        "allow": {
          "read": "true",
          "write": "true"
        }
      },
      "registrations/{regId}": {
        "allow": {
          "read": "true",
          "write": "true"
        }
      },
      "reviews/{reviewId}": {
        "allow": {
          "read": "true",
          "write": "true"
        }
      },
      "{document=**}": {
        "allow": {
          "read": "true",
          "write": "true"
        }
      }
    }
  }
}
